VITE_BACKEND_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
VITE_VOICE_ENGINE_URL=http://localhost:8001

# HMR config — override per environment
# Local dev (default, no SSL):
VITE_HMR_PROTOCOL=ws
VITE_HMR_HOST=localhost
# VITE_HMR_PORT=   # leave unset to use Vite default (8080)

# Production behind nginx SSL — uncomment these:
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_HOST=yourdomain.com
# VITE_HMR_PORT=443

# ============================================
# PostHog product analytics
# ============================================
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# Sentry error monitoring
# ============================================
VITE_SENTRY_DSN=

# ============================================
# In-app support chat widget
# Set to the agent ID to enable the floating support chat button
# ============================================
VITE_SUPPORT_AGENT_ID=
