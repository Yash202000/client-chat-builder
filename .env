VITE_BACKEND_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://intersee-isrh22yh.livekit.cloud
VITE_VOICE_ENGINE_URL=http://localhost:8001

# HMR config — override per environment
# Local dev (default, no SSL):
VITE_HMR_PROTOCOL=ws
VITE_HMR_HOST=localhost
# VITE_HMR_PORT=   # leave unset to use Vite default (8080)

# Production behind nginx SSL — uncomment these:
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_HOST=heygenally.com
# VITE_HMR_PORT=443